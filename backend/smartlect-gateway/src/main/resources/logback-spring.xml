<?xml version="1.0" encoding="UTF-8"?>
<!-- 网关独立日志配置（ADR-0009）：网关不依赖 smartlect-common（架构约定），
     自带一份最小脱敏 converter（2026-10-16 审计前这里无脱敏，只有注释声称"不含 PII"）。 -->
<configuration>
    <conversionRule conversionWord="maskingMsg"
                    converterClass="com.smartlect.cloud.gateway.logging.GatewayMaskingMessageConverter"/>
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="gateway"/>
    <springProperty scope="context" name="ROOT_LEVEL" source="logging.level.root" defaultValue="INFO"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [%X{traceId}] %logger{36} - %maskingMsg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="${ROOT_LEVEL}">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
