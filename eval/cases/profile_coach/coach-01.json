      "gender": "男",
      "birth_date": "1998-12-16",
      "rent_budget": 3500,
      "tidiness": "洁癖",
      "occupation": "公务员",
      "lease_term": "6-12个月",
      "store_id": 1,
      "schedule_type": "早睡早起",
      "has_pet": "无",
      "smoking": "偶尔",
      "self_intro": "做公务员的，公司离张江店不远。每天七点前起床晨跑，晚上很少熬夜。对卫生要求比较高。",
      "roommate_expectation": "希望室友作息规律、爱干净。",
      "interest_tags": [
        "爬山",
        "看电影"
      ]
    },
    "preference": {
      "age_min": 24,
      "age_max": 32,
      "age_required": "必须",
      "budget_min": 2500,
      "budget_max": 4000,
      "budget_required": "必须",
      "tidiness_min": "整洁",
      "tidiness_required": "加分",
      "store_scope": "同门店",
      "store_required": "必须",
      "schedule_accept": "早睡早起,正常作息",
      "schedule_required": "加分",
      "lease_min": "6-12个月",
      "lease_required": "加分",
      "pet_accept": "不接受",
      "pet_required": "加分"
    },
    "moments": [
      "今天把厨房收拾了一遍。",
      "周末去爬山了。"
    ]
  },
  "assertions": {
    "max_questions": 5,
    "must_include_fields": [
      "schedule_type",
      "budget_required"
    ],
    "must_not_include_fields": [
      "gender"
    ],
    "must_count_range": [
      2,
      4
    ]
  },
  "reference": {
    "questions": [
      {
        "field": "schedule_type",
        "question": "你写的「作息规律」具体是几点睡、几点起？"
      }
    ],
    "suggestions": [
      {
        "field": "schedule_type",
        "value": "早睡早起",
        "evidence": "每天七点前起床晨跑",
        "reason": "原文能确认作息习惯"
      },
      {
        "field": "budget_required",
        "value": "加分",
        "evidence": "需补充",
        "reason": "目前必须项有 3 个，若预算可浮动建议改成加分，给筛选官留放宽空间"
      }
    ],
    "intro_suggestion": null,
    "warnings": []
  }
