# Smartlect 三节点集群拓扑（deploy/cluster 的唯一 IP 事实源）
#
# 用法：脚本 `source nodes.env` 后按需取用；runtime.py 会把它注入 compose 的环境
# （因此这里不要写行内注释——行内注释会被解析进值里）。
#
# 节点角色：
#   node1 8c16g  MySQL 主 / Redis 主 / rocketmq(broker-DLedger+namesrv+proxy) / nacos-c1 / nginx / 应用主节点
#   node2 2c8g   Redis 副本 / rocketmq(broker-DLedger+namesrv+proxy) / nacos-c2 / 应用副本
#   node3 2c8g   Redis 副本 / rocketmq(broker-DLedger+namesrv+proxy) / nacos-c3 / 应用副本

NODE1_IP=172.21.131.151
NODE2_IP=172.19.34.202
NODE3_IP=172.19.34.203

NODE1_NAME=smartlect-node1
NODE2_NAME=smartlect-node2
NODE3_NAME=smartlect-node3

# 集群期中间件端口（host 网络，仅安全组内网放行）
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_DLEDGER_PORT=40911
ROCKETMQ_GRPC_PORT=8081
REDIS_PORT=6379
SENTINEL_PORT=26379
NACOS_PORT=8848

# 由 node1 发起的远端驱动
CLUSTER_SSH_OPTS="-o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10"
