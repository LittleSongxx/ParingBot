# SmartLect 本地部署配置（复制为 .env 后按需修改；.env 已被 git 忽略）
# 数据库口令与 JWT 密钥请务必改成随机值。生成方式：openssl rand -hex 24
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=smartlect
MYSQL_USER=smartlect
MYSQL_PASSWORD=change-me-smartlect
JWT_SECRET=change-me-random-secret
# 对外端口（只绑定 127.0.0.1）
APP_PORT=8080
# 文件访问地址前缀：留空表示返回相对路径（推荐，跟着当前域名走）
PUBLIC_BASE_URL=
MATCH_TIMEOUT_SECONDS=600
MAX_UPLOAD_MB=5
TZ=Asia/Shanghai
