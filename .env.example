# ParingBot 本地部署配置（复制为 .env 后按需修改；.env 已被 git 忽略）
# 数据库口令与 JWT 密钥请务必改成随机值。生成方式：openssl rand -hex 24
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=paringbot
MYSQL_USER=paringbot
MYSQL_PASSWORD=change-me-paringbot
JWT_SECRET=change-me-random-secret
# 对外端口（只绑定 127.0.0.1）
APP_PORT=8080
# 文件访问地址前缀：留空表示返回相对路径（推荐，跟着当前域名走）
PUBLIC_BASE_URL=
MATCH_TIMEOUT_SECONDS=600
MAX_UPLOAD_MB=5
TZ=Asia/Shanghai
# 登录防爆破（账号或 IP 维度；失败次数/窗口/锁定时长，测试可关）
LOGIN_MAX_FAILS=10
LOGIN_FAIL_WINDOW_SECONDS=300
LOGIN_LOCK_SECONDS=300
LOGIN_RATE_LIMIT_ENABLED=true
# 允许跨域的开发地址（生产同域部署可留默认）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
