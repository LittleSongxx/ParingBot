# ParingBot 评测环境（复制为 .env.eval 后填写；该文件已被 git 忽略）
# ---------------------------------------------------------------------------
# 重要：Key 只写入本机 .env.eval / 演示库 ai_model_config，绝不提交。
# 运行时 .env 只放数据库/端口；本文件是评测脚本与 workflow 读取的配置。

# 生产四角色模型（调度/画像/筛选/审核）
EVAL_PROVIDER=deepseek
EVAL_API_KEY=
EVAL_BASE_URL=
EVAL_MODEL=
EVAL_MAX_TOKENS=8192
EVAL_SCHEDULE_MODEL=
EVAL_PORTRAIT_MODEL=
EVAL_SCREENER_MODEL=
EVAL_AUDITOR_MODEL=

# 独立 judge：必须与生产模型不同族/供应商（同模型会被 judge.py 拒绝）
EVAL_JUDGE_PROVIDER=
EVAL_JUDGE_BASE_URL=
EVAL_JUDGE_API_KEY=
EVAL_JUDGE_MODEL=

# 评测运行参数（v3 冻结集）
EVAL_APP_BASE=http://127.0.0.1:8080
EVAL_ADMIN_USERNAME=admin
EVAL_ADMIN_PASSWORD=admin123
EVAL_SUITE=v3
DB_PROFILE=eval
EVAL_LABEL=v3-baseline
EVAL_TRIALS=1
EVAL_POLL_SECONDS=3
EVAL_MAX_WAIT_SECONDS=650
