# ParingBot 真实模型评测环境（复制本文件为 .env.eval 后填写）
# ---------------------------------------------------------------------------
# 重要：.env.eval 已被 git 忽略，不要提交；API Key 只写入本机文件 / 演示库，
# 评测结束后可用 `python eval/configure_models.py --clear` 清掉库里的 Key。
# 运行时 .env 只放数据库/端口等部署配置，模型 Key 不在 .env 里，而在
# ai_model_config 表（管理端【AI模型配置】可改）；本文件是给评测脚本读取的。
# ---------------------------------------------------------------------------

# 供应商预设推荐模型（2026-10 文档；以供应商控制台为准）：
#   deepseek -> deepseek-flash（省钱先跑通） / deepseek-v4-pro（更强）
#   qwen     -> qwen3.7-plus（平衡） / qwen3.8-flash（便宜） / qwen3.8-max（更强）
#   glm      -> glm-5.3 / glm-5.3-flash
#   openai   -> 以控制台当前 chat 模型为准（脚本占位 gpt-4.1-mini）

# 供应商预设：deepseek / qwen / glm / openai / custom
EVAL_PROVIDER=deepseek

# ===== 必填：供应商 API Key =====
# DeepSeek: https://platform.deepseek.com/api_keys
# 阿里云百炼 Qwen: https://bailian.console.aliyun.com/  （API-KEY 管理）
# 智谱 GLM: https://bigmodel.cn/usercenter/proj-mgmt/apikeys
# OpenAI: https://platform.openai.com/api-keys
EVAL_API_KEY=

# ===== 可选：覆盖预设的接口地址与模型名 =====
# 留空表示使用 eval/configure_models.py 里该供应商的推荐值；
# 自建网关/中转时把 EVAL_PROVIDER 设为 custom，并在这里填完整地址和模型名。
EVAL_BASE_URL=
EVAL_MODEL=

# 可选：每次模型调用的最大输出 Token（Qwen/长输出模型建议 8192）
EVAL_MAX_TOKENS=8192

# ===== 可选：四个用途分别用不同模型（留空沿用 EVAL_MODEL）=====
# 用途编码固定为：调度 / 画像 / 筛选 / 审核
EVAL_SCHEDULE_MODEL=
EVAL_PORTRAIT_MODEL=
EVAL_SCREENER_MODEL=
EVAL_AUDITOR_MODEL=

# ===== 评测运行参数 =====
EVAL_APP_BASE=http://127.0.0.1:8080
EVAL_ADMIN_USERNAME=admin
EVAL_ADMIN_PASSWORD=admin123
# 建议用 member02（已有完整档案/偏好/动态），避免把 member01 的演示记录冲掉
EVAL_MEMBER_USERNAME=member02
EVAL_MEMBER_PASSWORD=123456
# 报告里的标识，例如 baseline-deepseek / qwen-cross-check
EVAL_LABEL=baseline
# 真实匹配 trial 次数（每轮都会真实消耗模型 token，先 1 次）
EVAL_TRIALS=1
EVAL_POLL_SECONDS=3
EVAL_MAX_WAIT_SECONDS=600
